package zi:api;

world plugin {
    import editor;

    export lifecycle;
    export dependency;
    export command;
}

interface dependency {
    get-name: func() -> string;
    dependencies: func() -> list<string>;
}

interface lifecycle {
    use command.{command };

    record initialize-result {
        commands: list<command>,
    }

    initialize: func() -> initialize-result;
    shutdown: func();
}

// This is structured in a very particular way to get bindgen to do what we want (on both host and guest side).
// - Do not use anything from this interface in the main `world` otherwise the host will generate useless bindings.
// - If this is not in separate interface (and in the main world) we have the above issue + the guest doesn't generate bindings for this.
interface command {
    record arity {
        min: u8,
        max: u8,
    }

    flags command-flags {
        range,
    }

    record command {
        name: string,
        arity: arity,
        opts: command-flags,
    }

    variant command-error {
        message(string),
    }

    resource handler {
        constructor();
        exec: func(cmd: string, args: list<string>, force: bool) -> result<_, command-error>;
    }
}

interface editor {
    variant operator {
        delete,
        change,
        yank,
    }

    variant mode {
        normal,
        insert,
        visual,
        visual-line,
        visual-block,
        command,
        replace-pending,
        operator-pending(operator),
    }

    variant edit-error {
        readonly,
    }

    type line = u32;
    type byte-col = u32;

    record point {
       line: line,
       byte-col: byte-col,
    }

    insert: func(text: string) -> result<_, edit-error>;
    get-mode: func() -> mode;
    set-mode: func(mode: mode);
    get-active-view: func() -> view;

    save-all: func(force: bool) -> result<_, string>;
    reload: func() -> result<_, string>;
    open-jump-list: func();
    open-file-explorer: func(path: string);
    set-option: func(key: string, value: string) -> result<_, string>;

    record language-server {
        command: string,
        args: list<string>,
    }

    add-language-server: func(id: string, server: language-server);
    add-language: func(filetype: string, language-servers: list<string>) -> result<_, string>;

    enum position-encoding {
        utf8,
        utf16,
    }

    flags language-service-capabilities {
        definition,
        declaration,
        implementation,
        type-definition,
        references,
        completion,
        diagnostics,
        semantic-tokens,
        formatting,
    }

    record server-info {
        name: string,
        version: option<string>,
    }

    record language-service-details {
        server-info: option<server-info>,
        pid: option<u32>,
        root: string,
        position-encoding: option<position-encoding>,
        capabilities: language-service-capabilities,
    }

    variant language-service-state {
        /// Initialized and running.
        running(language-service-details),
        /// Initialized, but the server has since exited or crashed.
        exited(language-service-details),
        /// Waiting for `initialize` to return.
        starting,
        /// The last attempt to start it failed, with this error.
        failed(string),
        /// Defined, but no buffer of its file types has been opened yet.
        not-started,
        /// A language uses it, but it has no definition.
        undefined,
    }

    record language-service-status {
        id: string,
        state: language-service-state,
        command: option<language-server>,
        filetypes: list<string>,
    }

    /// Every language service that is defined or that a language uses, by id.
    get-language-services: func() -> list<language-service-status>;

    /// Every buffer, in no particular order.
    get-buffers: func() -> list<buffer>;
    /// A new readonly buffer holding `text`. It is removed once no view shows it.
    create-scratch-buffer: func(name: string, text: string) -> buffer;

    enum direction {
        left,
        right,
        up,
        down,
    }

    enum vertical-alignment {
        top,
        center,
        bottom,
    }

    flags buffer-flags {
        dirty,
    }

    resource view {
        exists: func() -> bool;
        get-buffer: func() -> buffer;
        get-cursor: func() -> point;
        set-cursor: func(pos: point);
        close: func();
        save: func(force: bool) -> result<_, string>;
        inspect: func();
        insert: func(text: string) -> result<_, edit-error>;
        delete-char: func() -> result<_, edit-error>;
        paste-after: func() -> result<_, edit-error>;
        undo: func() -> result<bool, edit-error>;
        redo: func() -> result<bool, edit-error>;
        scroll-by: func(direction: direction, amount: u32);
        align: func(alignment: vertical-alignment);
        focus: func();
        /// Split this view in `direction`, focus the new view and return it. It shows the same buffer.
        split: func(direction: direction) -> view;
        set-buffer: func(buf: borrow<buffer>);
    }

    resource buffer {
        exists: func() -> bool;
        get-file-path: func() -> option<string>;
        get-flags: func() -> buffer-flags;
        len-lines: func() -> u32;
        get-filetype: func() -> string;
    }
}


